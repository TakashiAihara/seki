# systemd unit for the seki server. Expects the repository at /opt/seki
# (scripts/fetch-pocketbase.sh already run), SEKI_TOKEN in /etc/seki/env, and a
# system user `seki` (useradd --system --no-create-home seki).
[Unit]
Description=seki lease server (PocketBase)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/seki/env
User=seki
Group=seki
StateDirectory=seki
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# No mail is set up. Hiding sendmail makes every PocketBase mail (login alerts, password
# reset, verification, OTP) fail at once instead of leaving a sendmail process retrying.
InaccessiblePaths=-/usr/sbin/sendmail -/usr/bin/sendmail -/usr/lib/sendmail
WorkingDirectory=/opt/seki
ExecStart=/opt/seki/bin/pocketbase serve --dir /var/lib/seki --hooksDir /opt/seki/pb_hooks --hooksWatch=false --migrationsDir /opt/seki/pb_migrations --http 0.0.0.0:8090
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
